{
  "name": "pantheon-tui",
  "type": "module",
  "version": "1.6.0-beta.15",
  "description": "Pantheon TUI plugin — V1 rich sidebar and usage gauges; native V2 status, session and delegation sidebar",
  "license": "MIT",
  "engines": {
    "node": ">=26.4.0"
  },
  "exports": {
    "./tui": "./dist/tui.js",
    "./tui-v2": "./dist/tui-v2.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist",
    "src",
    "tui.ts",
    "tui-v2.ts",
    "index-v2.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.33",
    "@opencode-ai/sdk": "1.18.33",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "rolldown-plugin-solid": "0.2.1",
    "tsdown": "0.23.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "seroval": "1.6.8",
    "solid-js": "1.9.12",
    "rolldown": "1.2.7"
  },
  "//overrides": "TUI production advisory fixes: Babel >=7.29.6 and Seroval >=1.6.3; Solid stays at 1.9.12 to satisfy OpenTUI's exact peer. Remove only after upstream ranges include fixed versions; Seroval compatibility is covered by the Solid serializer regression test.",
  "dependencies": {
    "@opencode-ai/plugin": "1.18.33",
    "@opencode/plugin": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12"
  }
}

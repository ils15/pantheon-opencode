#!/bin/bash
# Pantheon pre-commit hook
# Validates that committed files don't contain stale platform references
set -e

echo "🔍 Pantheon pre-commit check..."
stale_patterns="pantheon-orchestrator|scripts/install\\.mjs|platform/claude|platform/cursor|platform/windsurf|platform/cline|platform/continue|forge\\.json|sync-platforms\\.mjs"

if git diff --cached --name-only | xargs grep -ln "$stale_patterns" 2>/dev/null; then
  echo "❌ Stale platform references found in files above. Commit blocked."
  echo "   Replace: platform/claude → (already removed), sync-platforms.mjs → removed, etc."
  exit 1
fi
echo "✅ Pantheon pre-commit checks passed"

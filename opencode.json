{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "zeus",
  "subagent_depth": 2,
  "agent": {},
  "permission": {
    "skill": { "*": "allow" },
    "websearch": "deny",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "pip *": "allow"
    }
  },
  "instructions": [
    "AGENTS.md",
    "src/instructions/*.instructions.md"
  ],
  "plugin": [],
  "mcp": {
    "bifrost": {
      "type": "remote",
      "url": "https://llm.ofertachina.cloud/mcp",
      "enabled": true,
      "headers": {
        "x-bf-vk": "***REMOVED***"
      }
    }
  }
}

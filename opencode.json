{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "models": {
        "mimo-v2.5": {
          "attachment": true,
          "modalities": { "input": ["text", "image"] }
        }
      }
    }
  },
  "default_agent": "zeus",
  "experimental": {
    "subagent_depth": 2
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "websearch": "deny",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "pip *": "allow",
      "python3 *": "allow"
    }
  },
  "mcp": {
    "bifrost": {
      "type": "remote",
      "url": "https://llm.ofertachina.cloud/mcp",
      "enabled": true
    }
  },
  "agent": {
    "talos": {
      "permission": {
        "edit": {
          "*": "allow",
          "**/migrations/**": "deny",
          "**/alembic/**": "deny",
          "**/models/**": "deny",
          "**/auth/**": "deny",
          "**/*.sql": "deny"
        },
        "bash": {
          "*": "allow",
          "alembic *": "deny"
        }
      }
    }
  }
}

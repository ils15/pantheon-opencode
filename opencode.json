{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "models": {
        "mimo-v2.5": {
          "attachment": true,
          "modalities": { "input": ["text", "image"] }
        }
      }
    }
  },
  "default_agent": "zeus",
  "subagent_depth": 2,
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "websearch": "deny",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "pip *": "allow"
    }
  },
  "instructions": ["AGENTS.md", "src/instructions/*.instructions.md"],
  "plugin": [
    "/home/ils15/pantheon/src/plugin.ts",
    "/home/ils15/pantheon/src/plugins/pantheon-hooks.ts"
  ],
  "mcp": {
    "bifrost": {
      "type": "remote",
      "url": "https://llm.ofertachina.cloud/mcp",
      "enabled": true
    }
  },
  "agent": {
    "athena": {
      "model": "opencode-go/kimi-k3"
    },
    "themis": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "hephaestus": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "talos": {
      "permission": {
        "edit": {
          "*": "allow",
          "**/migrations/**": "deny",
          "**/alembic/**": "deny",
          "**/models/**": "deny",
          "**/auth/**": "deny",
          "**/*.sql": "deny"
        },
        "bash": {
          "*": "allow",
          "alembic *": "deny"
        }
      }
    }
  }
}

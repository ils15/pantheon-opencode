{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "zeus",
  "subagent_depth": 2,
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "websearch": "deny",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "pip *": "allow"
    }
  },
  "instructions": [
    "AGENTS.md",
    "src/instructions/*.instructions.md"
  ],
  "plugin": [],
  "mcp": {
    "bifrost": {
      "type": "remote",
      "url": "https://llm.ofertachina.cloud/mcp",
      "enabled": true,
      "headers": {
        "x-bf-vk": "sk-bf-a5a9b5b0-45fc-414d-8e4d-f9beb8c49a6d"
      }
    }
  },
  "agent": {
    "athena": {
      "model": "opencode-go/kimi-k3"
    },
    "themis": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "hephaestus": {
      "model": "opencode-go/deepseek-v4-pro"
    }
  }
}
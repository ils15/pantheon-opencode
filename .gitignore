node_modules/
dist/
# The TUI plugin dist is a build artifact that MUST ship in the npm package
# (the opencode tui loader loads dist/tui.tsx directly — relative refs break).
!src/plugins/tui/
!src/plugins/tui/dist/
!src/plugins/tui/dist/**
.venv/
.pantheon/*
# The code-mode payload ships inside the published tarball (package.json
# `files` includes .pantheon/code-mode/**) and the installer seeds the
# runtime scripts dir from it. It MUST be git-tracked: a fresh CI checkout
# without these files produces a tarball missing
# package/.pantheon/code-mode/compress-inline.py and empty runtime seed dirs.
# NOTE: `.pantheon/*` (not `.pantheon/`) so this negation can take effect —
# git cannot re-include paths under an excluded directory.
!.pantheon/code-mode/
!.pantheon/code-mode/**
.env
*.tgz
*.pyc
__pycache__/
.coverage*
.DS_Store
.vscode/
opencode.zen.json
opencode.multimodal.json
opencode.deepseek-only.json
opencode.local.json
opencode.json.backup
.mcp.json.backup
.github/release-notes.md
# Local validation logs are generated diagnostics and must not be versioned.
logs/
# Local plastic-example lab — never version
teste/

{
  "files": {
    "includes": [
      "**",
      "!src/plugins/tui/dist/**",
      "!.pantheon/**",
      "!tests/integration/**",
      "!tests/fixtures/**",
      "!.mypy_cache/**",
      "!.pytest_cache/**",
      "!.ruff_cache/**",
      "!.venv/**",
      "!.opencode/**",
      "!logs/**",
      "!benchmarks/**",
      "!teste/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}

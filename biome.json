{
  "files": {
    "includes": [
      "**",
      "!src/plugins/tui/dist",
      "!tests/integration",
      "!.mypy_cache",
      "!.pytest_cache",
      "!.ruff_cache",
      "!.venv",
      "!.opencode",
      "!logs"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
